{
  "name": "@kb-labs/setup-engine-core",
  "version": "0.1.6",
  "description": "Core analysis, planning, and execution engine for KB Labs setup workflows.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/kirill-baranov/kb-labs-setup-engine.git",
    "directory": "packages/setup-engine"
  },
  "bugs": {
    "url": "https://github.com/kirill-baranov/kb-labs-setup-engine/issues"
  },
  "homepage": "https://github.com/kirill-baranov/kb-labs-setup-engine/tree/main/packages/setup-engine",
  "keywords": [
    "kb-labs",
    "setup",
    "engine",
    "idempotent",
    "planner",
    "executor"
  ],
  "dependencies": {
    "@kb-labs/setup-engine-operations": "workspace:^0.1.0"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsup",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run -c ../../vitest.config.ts",
    "test:watch": "vitest -c ../../vitest.config.ts"
  },
  "devDependencies": {
    "@kb-labs/devkit": "link:../../../kb-labs-devkit",
    "@types/node": "^24.3.3",
    "tsup": "^8.5.0",
    "vitest": "^3.2.4",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3"
  },
  "private": true,
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
